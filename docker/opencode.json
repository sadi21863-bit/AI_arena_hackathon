{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["/opt/opencode/skills"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "node",
        "/usr/local/lib/node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--browser=chromium",
        "--isolated",
        "--image-responses",
        "omit",
        "--output-dir",
        "/tmp/playwright-artifacts",
        "--config",
        "/opt/arena-mcp/playwright-mcp.json"
      ]
    }
  },
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "su *": "deny",
      "sudo *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "chroot *": "deny",
      "nsenter *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  },
  "provider": {
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPEN_ROUTER_API_KEY}"
      },
      "models": {
        "nvidia/nemotron-3.5-lightning:free": {
          "name": "Nemotron 3.5 Lightning (OpenRouter free)",
          "tool_call": true,
          "limit": { "context": 1000000, "output": 16384 }
        },
        "dots-studio/dots-3-note-preview:free": {
          "name": "Dots 3 Note Preview (OpenRouter free)",
          "tool_call": true,
          "limit": { "context": 512000, "output": 16384 }
        },
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B (OpenRouter free)",
          "tool_call": true,
          "limit": { "context": 1000000, "output": 16384 }
        }
      }
    }
  }
}
