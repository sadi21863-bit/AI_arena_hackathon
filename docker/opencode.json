{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["/opt/opencode/skills"]
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "node",
        "/usr/local/lib/node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--browser=chromium",
        "--isolated",
        "--image-responses",
        "omit",
        "--output-dir",
        "/tmp/playwright-artifacts",
        "--config",
        "/opt/arena-mcp/playwright-mcp.json"
      ]
    }
  },
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "su *": "deny",
      "sudo *": "deny",
      "mount *": "deny",
      "umount *": "deny",
      "chroot *": "deny",
      "nsenter *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  },
  "provider": {
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Groq",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B (Groq)",
          "tool_call": true,
          "limit": { "context": 131072, "output": 16384 }
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B (Groq)",
          "tool_call": true,
          "limit": { "context": 131072, "output": 16384 }
        },
        "qwen/qwen3.8-27b": {
          "name": "Qwen 3.8 27B (Groq)",
          "tool_call": true,
          "limit": { "context": 32768, "output": 16384 }
        }
      }
    }
  }
}
