# apply_schema.js writes SQL to a temp file and unlinks it in a finally block.
# A killed run (Ctrl-C, a terminated background job) skips that cleanup, leaving a
# stray file that git add -A would otherwise happily stage.
scripts/.apply_schema_*.sql
