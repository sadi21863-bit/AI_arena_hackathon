# Copy to .env for local use (never commit .env — it is gitignored).
# Worker secrets are set via `wrangler secret put <NAME>`; Actions secrets
# via repo Settings → Secrets. See src/env.ts for the binding contract.

# --- Cloudflare (wrangler CLI + Worker runtime; same values, two names) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Groq (Worker secret; _2 optional second account for burst spreading) ---
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_1=

# --- Agents / research (Worker secrets) ---
AGENT_API_TOKEN=
TAVILY_API_KEY_1=
TAVILY_API_KEY_2=
TAVILY_API_KEY_3=
TAVILY_API_KEY=

# --- GitHub (Worker secret GITHUB_TOKEN is a classic PAT, scopes repo + workflow) ---
GITHUB_TOKEN=
GITHUB_ORG=

# --- Optional operational alerts (Worker secret) ---
# When set, the scheduled tick POSTs a small JSON body for subrequest-headroom
# and capacity-pause alerts. Without it, alerts are still persisted in D1 and
# visible on /headroom and /alerts.
ALERT_WEBHOOK_URL=

# --- Actions-only repo secrets (not Worker env) ---
# PAT with `workflow` scope for team-build-turn.yml pushes (GITHUB_TOKEN can never carry it)
ARENA_PUSH_TOKEN=
# OpenCode API key injected into the build-turn container only
OPENCODE_API_KEY=
